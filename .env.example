# Local dev / demo (docker-compose.yml) or `python -m uvicorn` directly.
# For production, use .env.prod.example -> .env.prod with docker-compose.prod.yml instead.

# ---- LLM: any OpenAI-compatible API. Leave LLM_API_KEY empty to run fully offline
# (deterministic fallbacks, no network calls). Default endpoint is NVIDIA's hosted API catalog
# (free tier, OpenAI-compatible) — swap LLM_BASE_URL/LLM_API_KEY for vLLM, Ollama, Azure OpenAI,
# a company gateway, etc.
LLM_MODE=auto
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL_REASONING=meta/llama-3.3-70b-instruct
LLM_MODEL_AGENT=meta/llama-3.3-70b-instruct
LLM_MODEL_FAST=meta/llama-3.1-8b-instruct
# nvext (NIM guided_json) | json_schema | json_object (OpenAI response_format) | prompt (instructions only)
LLM_JSON_MODE=nvext
# native (OpenAI tool calling) | json (JSON action protocol, for models without tool calling)
LLM_TOOL_MODE=native
LLM_MAX_CONCURRENCY=4

# dev = persona switcher (X-Dev-User header, no real auth) | keycloak = OIDC login, bearer JWT
# validated by the API. Dev mode refuses to start when ENVIRONMENT=production.
# native = DeliveryOps accounts, signed in with any of AUTH_PROVIDERS below (recommended).
AUTH_MODE=dev

# ---- Sign-in methods (AUTH_MODE=native) ----
# Comma-separated: password, microsoft, google. One account can link several (Mon compte).
# microsoft needs MICROSOFT_TENANT_ID / MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET, google needs
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. Register this redirect URI with each provider (type "Web"):
#   {FRONTEND_URL}/api/auth/oidc/microsoft/callback   and   {FRONTEND_URL}/api/auth/oidc/google/callback
# Switching from AUTH_MODE=microsoft keeps everyone's role: Microsoft users are imported at startup.
AUTH_PROVIDERS=password
# Who may create an account by signing in with Microsoft/Google (e-mail domains). Empty = anyone,
# but new people get no access until an admin assigns them a role.
AUTH_ALLOWED_DOMAINS=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only accept Google accounts of this Workspace domain
GOOGLE_HOSTED_DOMAIN=
# Encrypts secrets stored in the database (2FA secrets, LLM API keys entered in the UI). Set once.
SECRETS_KEY=
# "Mot de passe oublié" e-mails (password method)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Embeddings: hash (offline, weak) | fastembed (local model) | api (real semantic, uses LLM_API_KEY).
# `api` is recommended when an LLM key is set: paraphrases and synonyms match, not just keywords.
# After changing the provider or model, re-embed stored docs: cd backend && python -m app.reindex
EMBEDDING_PROVIDER=hash
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_MODEL=nvidia/nemotron-3-embed-1b
# EMBEDDING_DIM=2048
# KNOWLEDGE_RERANK=true

# Proactive watch: connector sync + deterministic checks every N minutes
WATCH_ENABLED=true
WATCH_INTERVAL_MINUTES=15
# Proactive AI suggestions: on top of the deterministic checks above, run the risk/billing agents
# (read-only) every Nth watch cycle and post a genuinely new finding as an "ai_suggestion"
# notification. Skipped automatically when a perimeter's data hasn't changed since the last pass.
WATCH_AI_ENABLED=true
WATCH_AI_EVERY_N_CYCLES=4
WATCH_AI_AGENTS=risk

# Optional: Teams Workflows webhook URL for approval requests and critical alerts (Adaptive Cards)
TEAMS_WEBHOOK_URL=

# Connector credentials are referenced by name from the connector config (token_env), e.g.
# JIRA_TOKEN=
# SERVICENOW_PASSWORD=

# Keycloak admin API (optional, powers the in-app Users page). Leave the secret empty to manage
# users directly in the Keycloak console instead. See README "Keycloak admin API" for setup.
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8280
KEYCLOAK_ADMIN_CLIENT_ID=deliveryops-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

POSTGRES_PASSWORD=deliveryops
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- Microsoft Entra ID (Azure AD) SSO + Microsoft Graph ----
# Register an app in the Azure Portal (see README "Microsoft Entra ID setup"), then paste its
# Application (client) ID and Directory (tenant) ID here. Set AUTH_MODE=microsoft to make Microsoft
# the sign-in front door (the app then picks up the account signed into the PC). Leave empty to
# disable. No client secret needed — the SPA holds the token, the backend relays it to Graph.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
