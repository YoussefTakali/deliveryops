# Production deployment (docker-compose.prod.yml). Copy to .env.prod, fill in every value below,
# then: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# See README "Production deployment" for the full first-boot checklist (DNS, realm secret, first
# admin user).

# ---- DNS: both must resolve to this server before starting Caddy, or cert issuance will fail ----
DOMAIN=delivery.example.com
AUTH_DOMAIN=auth.delivery.example.com
# Let's Encrypt account contact (renewal/expiry notices only, not public)
ACME_EMAIL=ops@example.com

# ---- Secrets: generate strong random values, e.g. `openssl rand -base64 32` ----
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# From the Keycloak Admin Console after first boot: Clients -> deliveryops-admin -> Credentials
# tab -> Client secret. Leave empty to manage users directly in Keycloak instead of the in-app
# Users page.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ---- LLM: any OpenAI-compatible API. Leave LLM_API_KEY empty to run fully offline. ----
LLM_MODE=auto
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL_REASONING=meta/llama-3.3-70b-instruct
LLM_MODEL_AGENT=meta/llama-3.3-70b-instruct
LLM_MODEL_FAST=meta/llama-3.1-8b-instruct

# ---- Optional ----
TEAMS_WEBHOOK_URL=
WATCH_INTERVAL_MINUTES=15
WATCH_AI_ENABLED=true
WATCH_AI_EVERY_N_CYCLES=4
WATCH_AI_AGENTS=risk
